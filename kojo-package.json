{
  "id": "discord",
  "name": "Discord",
  "version": "0.2.0",
  "description": "Connect a kojo agent to Discord: it answers mentions, replies, threads and DMs, and can post on its own.",
  "kojoVersion": ">0.135.0",
  "scopes": ["chat:session"],
  "contributes": {
    "service": {
      "scope": "per-agent",
      "exec": {
        "darwin/arm64": "bin/darwin-arm64/kojo-ext-discord",
        "darwin/amd64": "bin/darwin-amd64/kojo-ext-discord",
        "linux/amd64": "bin/linux-amd64/kojo-ext-discord",
        "linux/arm64": "bin/linux-arm64/kojo-ext-discord",
        "windows/amd64": "bin/windows-amd64/kojo-ext-discord.exe"
      }
    },
    "mcpServers": [
      {
        "name": "bot",
        "exec": {
          "darwin/arm64": "bin/darwin-arm64/kojo-ext-discord",
          "darwin/amd64": "bin/darwin-amd64/kojo-ext-discord",
          "linux/amd64": "bin/linux-amd64/kojo-ext-discord",
          "linux/arm64": "bin/linux-arm64/kojo-ext-discord",
          "windows/amd64": "bin/windows-amd64/kojo-ext-discord.exe"
        },
        "args": ["mcp"]
      }
    ],
    "settings": {
      "scope": "per-agent",
      "schema": "settings.schema.json"
    }
  }
}
